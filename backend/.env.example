# Copy to backend/.env for local work. NEVER commit the real file, and never put production
# secrets in one — in production these come from the platform's secret store (AWS Secrets
# Manager, Vault, Kubernetes secrets), injected as environment variables.
#
# Check a deployment's configuration before shipping it:
#   python3 -m backend.config        # fails loudly on anything unsafe for production
#   python3 -m backend.admin preflight

# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------
# "production" makes every default strict and refuses to start if anything below is unsafe.
APP_ENV=development

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------
# Use a dedicated least-privilege MySQL account, not root.
#   CREATE DATABASE raahat_dw CHARACTER SET utf8mb4;
#   CREATE USER 'raahat'@'%' IDENTIFIED BY '...';
#   GRANT SELECT,INSERT,UPDATE,DELETE ON raahat_dw.* TO 'raahat'@'%';
DATABASE_URL=mysql://root:@localhost:3306/raahat_dw

# Pepper for session-token hashing. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it signs everyone out — which is exactly what you want after a suspected leak.
SESSION_SECRET=

# Comma-separated hostnames this app will answer to. Blocks Host-header poisoning.
ALLOWED_HOSTS=
# Only needed if the frontend is served from a different origin than the API.
ALLOWED_ORIGINS=
# Set to 1 ONLY when a trusted proxy/load balancer sits in front. It makes the app believe
# X-Forwarded-For, which a direct client could otherwise forge to escape rate limiting.
TRUST_PROXY_HEADERS=0

# ---------------------------------------------------------------------------
# Shared state — required for more than one worker process
# ---------------------------------------------------------------------------
# Without it, rate-limit counters are per-process and a WebSocket alert only reaches the
# worker that raised it. Single-worker development can leave it unset.
REDIS_URL=

# ---------------------------------------------------------------------------
# Feature switches (production defaults shown; all refuse unsafe values in production)
# ---------------------------------------------------------------------------
# Creates the three demo logins whose passwords are in the README. Production: must be 0.
SEED_DEMO_DATA=1
# /api/db returns every table including participant chat transcripts. Production: 0.
ENABLE_DB_INSPECTOR=1
# /docs, /redoc, /openapi.json.
ENABLE_API_DOCS=1
# Serve the pre-transpiled bundle (npm run build) instead of in-browser Babel.
REQUIRE_FRONTEND_BUNDLE=0

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
SESSION_TTL_SECONDS=43200
SESSION_MAX_LIFETIME_SECONDS=86400

# ---------------------------------------------------------------------------
# Escalation delivery — the safety-critical path
# ---------------------------------------------------------------------------
# Where a High/Critical escalation is POSTed (on-call endpoint, Slack webhook). Unset means
# escalations only reach the log, which nobody is watching at 2am.
ALERT_WEBHOOK_URL=
# How long a High/Critical alert may sit unacknowledged before it is re-paged.
ESCALATION_ACK_SECONDS=300

# ---------------------------------------------------------------------------
# Data protection
# ---------------------------------------------------------------------------
# Delete participant content older than this many days (0 disables). Run the job with
# `python3 -m backend.admin purge-data`; keeping distress disclosures forever is a
# liability, and the DPDP Act 2023 expects a stated, enforced retention period.
DATA_RETENTION_DAYS=0

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
# Gemini generates NON-URGENT chat replies only. Urgent/safety messages always use the
# local deterministic responses, never the LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 only after the SentenceTransformer model has been downloaded locally.
NLP_SEMANTIC_ENABLED=0

# Phone IVR (FreeSWITCH dialplan). The dialplan sends this as the X-IVR-Key header and the
# caller's number as ?caller=... — an unregistered number is refused, not defaulted. Link a
# number to a case with database.link_phone(). Must be 32+ random characters in production.
ENABLE_IVR=0
IVR_API_KEY=
# Single-tenant pilot line only: the case an unrecognised caller is attributed to. Leave
# unset — defaulting one person's answers into another person's record is a data breach.
IVR_FALLBACK_CASE_ID=

# Twilio phone-number IVR (/api/twilio/*). Twilio signs every webhook with this token, and
# the signature check FAILS CLOSED without it — the endpoints can fire Critical escalations.
ENABLE_TWILIO=0
TWILIO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_VOICE=Polly.Aditi

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=text        # "json" in production, for a log shipper
SENTRY_DSN=

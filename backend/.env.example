# Optional. Never put this file in version control.

# MySQL connection for the app's database. Create the schema first:
#   mysql -u root -p -e "CREATE DATABASE raahat_dw CHARACTER SET utf8mb4"
DATABASE_URL=mysql://root:@localhost:3306/raahat_dw

# Enables Gemini-generated replies for NON-URGENT chat messages only.
# Urgent/safety messages always use the local deterministic responses, never the LLM.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Set to 1 only after the SentenceTransformer model has been downloaded locally.
NLP_SEMANTIC_ENABLED=0

# Optional. If set, every High/Critical escalation is POSTed here as JSON
# (e.g. a Slack incoming webhook, or an internal on-call endpoint).
# Escalations are always logged to the server console regardless.
ALERT_WEBHOOK_URL=

# Shared secret the local IVR (FreeSWITCH dialplan) sends as the X-IVR-Key header on
# /api/ivr/* calls, since a phone call has no web login/session. Demo-only: a real
# deployment would authenticate IVR calls some other way (caller-ID to case lookup, etc).
IVR_API_KEY=demo-ivr-key

# Only needed to let backend/ivr/setup_twilio.py point your number at this server over the
# REST API. Signature checking does not use it. Found on the console.twilio.com dashboard.
TWILIO_ACCOUNT_SID=

# Only needed for the Twilio phone-number IVR (/api/twilio/*). Twilio signs every webhook
# with this token; leave it unset and signature checking is skipped (local curl testing only
# — always set it before pointing a real Twilio number at this server).
TWILIO_AUTH_TOKEN=
# Optional: any Twilio voice name. Defaults to Polly.Aditi (Indian English).
TWILIO_VOICE=Polly.Aditi
